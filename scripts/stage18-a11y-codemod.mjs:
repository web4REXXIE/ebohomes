// Stage 18 step 7: accessibility and dark-mode pass for the admin pages. Run once from the repo root:
//   node scripts/stage18-a11y-codemod.mjs
// It is safe to run twice. It only changes class names and adds aria-label attributes. It never touches
// data calls, handlers, text or logic. Use `git diff` to review, and `git checkout -- app/admin` to undo.
import { readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs'
import { join } from 'node:path'

function pages(dir) {
  return readdirSync(dir).flatMap((n) => {
    const p = join(dir, n)
    return statSync(p).isDirectory() ? pages(p) : n === 'page.tsx' ? [p] : []
  })
}

// ---- 1. Labels --------------------------------------------------------------------------------
// Finds the end of a JSX tag, skipping over {...} so that arrow functions (=>) do not end it early.
function tagEnd(s, start) {
  let depth = 0
  for (let i = start; i < s.length; i++) {
    const c = s[i]
    if (c === '{') depth++
    else if (c === '}') depth--
    else if (c === '>' && depth === 0 && s[i - 1] !== '=') return i
  }
  return -1
}

// Labels for controls that have neither a visible label nor a placeholder. Keyed by the value expression.
const BY_VALUE = {
  'summary': 'Public summary shown on the listing',
  'note': 'Review note',
  'reason': 'Reason',
  'select:reason': 'Reason for the inspection',
  "j.inspector_id ?? ''": 'Assigned inspector',
  'outcome': 'Review outcome',
  'relayText': 'Message to relay',
  'draft': 'Reply message',
  'active.status': 'Support ticket status',
  'pick[a.id] ? pick[a.id] : ROLES[0]': 'Role to assign',
  'filter': 'Filter',
  'search': 'Search',
  'query': 'Search',
  'val': 'Value',
  'suspendReason': 'Reason for suspending',
  'publicId': 'Property ID',
  'notes[h.id] ?? \'\'': 'Note',
}

// A short accessible name from a long placeholder: the text before the first bracket, comma, full stop or ellipsis.
function short(text) {
  const cut = text.split(/\s*[(,…]|\.\s|\.$/)[0].trim()
  return (cut.length >= 3 ? cut : text.trim()).replace(/"/g, '&quot;')
}

function addLabels(src, file) {
  let out = '', i = 0, added = 0
  const re = /<(input|textarea|select)\b/g
  let m
  while ((m = re.exec(src))) {
    const end = tagEnd(src, m.index)
    if (end < 0) continue
    const tag = src.slice(m.index, end + 1)
    out += src.slice(i, m.index)
    i = m.index
    const before = src.slice(0, m.index)
    const wrapped = before.lastIndexOf('<label') > before.lastIndexOf('</label>')
    const named = /aria-label|aria-labelledby|\bid=|type="hidden"/.test(tag)
    if (wrapped || named) continue
    let label = null
    const lit = tag.match(/placeholder="([^"]+)"/)
    const expr = tag.match(/placeholder=\{((?:[^{}]|\{[^{}]*\})*)\}/)
    const val = tag.match(/value=\{((?:[^{}]|\{[^{}]*\})*)\}/)
    if (lit) label = `aria-label="${short(lit[1])}"`
    else if (expr) label = `aria-label={${expr[1]}}`
    else if (val) {
      const key = val[1].trim()
      const name = BY_VALUE[`${m[1]}:${key}`] ?? BY_VALUE[key]
      if (name) label = `aria-label="${name}"`
    }
    if (!label) { console.log(`  needs a manual label: ${file}: ${tag.slice(0, 80).replace(/\s+/g, ' ')}`); continue }
    out += `<${m[1]} ${label}`
    i = m.index + m[0].length
    added++
  }
  out += src.slice(i)
  return { out, added }
}

// ---- 2. Dark mode: fixed colours become the status tokens from app/globals.css ----------------
const FAMILY = { emerald: 'success', green: 'success', amber: 'warning', yellow: 'warning', orange: 'warning', red: 'danger', rose: 'danger', sky: 'info', blue: 'info' }
function tokens(src) {
  let s = src
  for (const [f, t] of Object.entries(FAMILY)) {
    s = s.replace(new RegExp(`\\bbg-${f}-(?:50|100)\\b`, 'g'), `bg-${t}-soft`)
    s = s.replace(new RegExp(`\\btext-${f}-(?:600|700|800|900)\\b`, 'g'), `text-${t}`)
    s = s.replace(new RegExp(`\\bborder-${f}-(?:200|300|400)\\b`, 'g'), `border-${t}/30`)
  }
  return s
    .replace(/\bbg-red-(?:600|700)( [^'"`]*?)?\btext-white\b/g, (_m, mid = '') => `bg-destructive${mid}text-white dark:text-background`)
    .replace(/\bbg-red-(?:600|700)\b/g, 'bg-destructive')
    .replace(/\btext-purple-700 bg-purple-50\b/g, 'text-foreground bg-secondary')
    .replace(/\bbg-slate-100\b/g, 'bg-secondary').replace(/\bbg-gray-100\b/g, 'bg-secondary')
    .replace(/\btext-(?:slate|gray)-(?:600|700|800)\b/g, 'text-muted-foreground')
    .replace(/\bborder-(?:slate|gray)-(?:200|300)\b/g, 'border-border')
}

let labelled = 0, changed = 0
for (const file of pages('app/admin')) {
  const before = readFileSync(file, 'utf8')
  const { out, added } = addLabels(before, file)
  const after = tokens(out)
  labelled += added
  if (after !== before) { writeFileSync(file, after); changed++; console.log(`updated ${file}`) }
}
console.log(`\n${changed} files updated, ${labelled} fields labelled.`)
